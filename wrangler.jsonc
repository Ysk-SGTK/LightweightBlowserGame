{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "browser-game-lab",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-04",
  "send_metrics": false,
  "d1_databases": [{
    "binding": "GAME_LOG_DB",
    "database_name": "browser-game-lab-events",
    // Database ID supplied by the owner; remote migration is a separate step.
    "database_id": "9d4b7505-3f13-45db-96f8-82a46b752a5d",
    "migrations_dir": "migrations"
  }],
  // Preview deployments fail logging safely until given a separate preview DB.
  "env": { "preview": { "d1_databases": [] } }
}
